# ---- 백엔드 API ----
# 브라우저에서 직접 호출하므로 공개 변수로 둔다
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- NextAuth ----
# openssl rand -base64 32 으로 생성
AUTH_SECRET=change-me-to-a-random-32-byte-string
AUTH_URL=http://localhost:3000

# ---- Google OAuth ----
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# 로그인 허용 이메일 도메인 (백엔드 ALLOWED_EMAIL_DOMAINS와 같은 값을 쓴다)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=hanyang.ac.kr
