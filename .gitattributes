# 기본적으로 텍스트 파일은 저장소에 LF로 저장한다.
# 체크아웃 시에는 각자 OS에 맞게 변환된다.
* text=auto eol=lf

# gradlew는 리눅스/CI에서 실행되므로 반드시 LF여야 한다.
# CRLF로 커밋되면 "bad interpreter" 오류로 빌드가 깨진다.
gradlew text eol=lf
*.sh text eol=lf

# 윈도우 전용 스크립트는 CRLF 유지
*.bat text eol=crlf

# 바이너리
*.jar binary
*.png binary
*.jpg binary
*.ico binary
